<Window x:Class="Market.Windows.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать товар" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Title}" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <!-- Short Title -->
        <TextBlock Text="Краткое название:" Grid.Row="1" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.ShortTitle}" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <!-- Description -->
        <TextBlock Text="Описание:" Grid.Row="2" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Description}" Grid.Row="2" Grid.Column="1" Margin="5" AcceptsReturn="True" Height="60"/>

        <!-- Category -->
        <TextBlock Text="Категория:" Grid.Row="3" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Category}" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <!-- Price -->
        <TextBlock Text="Цена:" Grid.Row="4" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Price}" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <!-- Quantity -->
        <TextBlock Text="Количество:" Grid.Row="5" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Quantity}" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <!-- Manufacturer -->
        <TextBlock Text="Производитель:" Grid.Row="6" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Manufacturer}" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <!-- Year -->
        <TextBlock Text="Год:" Grid.Row="7" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Year}" Grid.Row="7" Grid.Column="1" Margin="5"/>

        <!-- Engine Type -->
        <TextBlock Text="Тип двигателя:" Grid.Row="8" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.EngineType}" Grid.Row="8" Grid.Column="1" Margin="5"/>

        <!-- Marking -->
        <TextBlock Text="Маркировка:" Grid.Row="9" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.Marking}" Grid.Row="9" Grid.Column="1" Margin="5"/>

        <!-- Engine Number -->
        <TextBlock Text="Номер двигателя:" Grid.Row="10" Grid.Column="0" Margin="5"/>
        <TextBox Text="{Binding NewProduct.EngineNumber}" Grid.Row="10" Grid.Column="1" Margin="5"/>
        <!-- Multiple Images -->
        <TextBlock Text="Изображения:" Grid.Row="11" Grid.Column="0" Margin="5"/>
        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
            <Button Content="Добавить" Margin="5" Click="AddImage_Click"/>
            <ItemsControl ItemsSource="{Binding NewProduct.ImagePaths}" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Height="50" Margin="2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- Colors -->
        <TextBlock Text="Цвета:" Grid.Row="12" Grid.Column="0" Margin="5"/>
        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="ColorTextBox" Width="100" Margin="5"/>
            <Button Content="+" Margin="5" Click="AddColor_Click"/>
            <ItemsControl ItemsSource="{Binding NewProduct.Colors}" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- Sizes -->
        <TextBlock Text="Размеры:" Grid.Row="13" Grid.Column="0" Margin="5"/>
        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="SizeTextBox" Width="100" Margin="5"/>
            <Button Content="+" Margin="5" Click="AddSize_Click"/>
            <ItemsControl ItemsSource="{Binding NewProduct.Sizes}" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- Related Products -->
        <TextBlock Text="Связанные товары:" Grid.Row="14" Grid.Column="0" Margin="5"/>
        <ListBox ItemsSource="{Binding NewProduct.RelatedProducts}" Grid.Row="14" Grid.Column="1" Height="60" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Buttons -->
        <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="5" Click="OKButton_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="CancelButton_Click"/>
            <!-- В StackPanel с кнопками (Grid.Row="16") -->
            <Button Content="{DynamicResource Language}" Width="80" Margin="5" Click="LanguageButton_Click"/>
        </StackPanel>
        
        
    </Grid>
</Window>