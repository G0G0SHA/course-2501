<Window x:Class="Market.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AuthTitle}" Height="233" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Login}" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Margin="0,0,0,15"/>

            <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

            <Button Content="{DynamicResource Login}" Click="LoginButton_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>