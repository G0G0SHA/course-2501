<Window x:Class="Market.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" 
        Height="600" 
        Width="1320"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <!-- Основной контейнер -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип и фильтры -->
        <StackPanel Grid.Column="0" x:Name="LeftPanel">
            <!-- Логотип -->
            <Grid Background="LightGray" Width="200" Height="80">
                <Image Source="/Icons/logo.png" Stretch="Uniform" Height="120" Width="120"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Панель фильтров -->
            <StackPanel Grid.Column="0" Background="#f0f0f0" Margin="0,60,0,0">
                <TextBlock Text="{DynamicResource Filters}" FontWeight="Bold" Margin="5" FontSize="14"/>
                <GroupBox Header="{DynamicResource Category}" Margin="5">
                    <ComboBox x:Name="CategoryComboBox"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="."/>

                </GroupBox>

                <GroupBox Header="{DynamicResource Price}" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="178">
                        <TextBlock Text="{DynamicResource From}" Margin="5"/>
                        <TextBox x:Name="PriceFromTextBox" Width="60"/>
                        <TextBlock Text="{DynamicResource To}" Margin="5"/>
                        <TextBox x:Name="PriceToTextBox" Width="60" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource Availability}" Margin="5">
                    <CheckBox x:Name="InStockCheckBox" Content="{DynamicResource InStockOnly}" IsChecked="True"/>
                </GroupBox>

                <!--<GroupBox Header="{DynamicResource Color}" Margin="5">
                    <ComboBox x:Name="ColorFilterComboBox" 
                              ItemsSource="{Binding AllColors}" 
                              SelectedItem="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </GroupBox>

                <GroupBox Header="{DynamicResource Size}" Margin="5">
                    <ComboBox x:Name="SizeFilterComboBox" 
                              ItemsSource="{Binding AllSizes}" 
                              SelectedItem="{Binding SelectedSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </GroupBox>-->

                <Button Content="{DynamicResource ResetFilters}" Margin="5" Command="{Binding ResetFiltersCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Основное содержимое -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="600"/>
                    <!-- Гибкое пространство для поиска -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Фиксированная ширина для иконок -->
                </Grid.ColumnDefinitions>

                <!-- Поиск (левая часть) -->
                <Border Grid.Column="0" Background="#889199" Height="80">
                    <Grid VerticalAlignment="Center" Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="500"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="5" VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                   Content="{DynamicResource Search}" 
                   Width="80"
                   Height="40"
                   Margin="0,0,0,0"
                   Command="{Binding ApplyFiltersCommand}"/>
                    </Grid>
                </Border>

                <!-- Иконки и язык (правая часть) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Иконки -->
                    <Grid Width="80" Height="80" Background="#303030">
                        <Image Source="/Icons/icons8-box-128.png" 
                   Stretch="Uniform" 
                   Height="40" 
                   Width="40" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="80" Height="80" Background="#5f5f5f">
                        <Image Source="/Icons/icons8-account-50.png" 
                   Stretch="Uniform" 
                   Height="40" 
                   Width="40"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="80" Height="80" Background="#4c4c4c">
                        <Image Source="/Icons/icons8-bell-96.png" 
                   Stretch="Uniform" 
                   Height="40" 
                   Width="40"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="80" Height="80" Background="#4c4c4c">
                        <Image Source="/Icons/icons8-basket-96.png" 
                            Stretch="Uniform" 
                            Height="40" 
                            Width="40"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Переключатель языка -->

                    <StackPanel Orientation="Horizontal" 
                   VerticalAlignment="Center" 
                   Margin="10,0,10,0">
                        <Button Content="RU" 
                   Width="40" 
                   Click="LanguageRu_Click"/>
                        <Button Content="EN" 
                   Width="40" 
                   Margin="5,0,0,0" 
                   Click="LanguageEn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Панель меню -->
            <Grid Background="#262626" Grid.Row="1" Margin="-200,0,0,0">
                <UniformGrid Rows="1" HorizontalAlignment="Center" Width="1200">
                    <Button Content="{DynamicResource Calendar}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource Database}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource Contacts}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource Report}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource Staff}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource Calculator}" Margin="5" Height="50"/>
                    <Button Content="{DynamicResource AddProduct}" Margin="5" Height="50" 
                            Command="{Binding AddProductCommand}"
                            Visibility="{Binding CurrentUser.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </UniformGrid>
            </Grid>

            <!-- Список товаров -->
            <Grid Grid.Row="2" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PartsItemsControl" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="White" Margin="0,0,0,15" 
                                        BorderBrush="LightGray" BorderThickness="1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Изображение товара -->
                                        <Grid Grid.Column="0">
                                            <Button Style="{StaticResource TransparentButtonStyle}"
                                                    Command="{Binding DataContext.OpenProductCommand, 
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}">
                                                <Image Source="{Binding ImagePath}" Height="120" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>

                                        <!-- Описание товара -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{DynamicResource Year}" Width="100" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Year}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource EngineType}" Width="100" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EngineType}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource Marking}" Width="100" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Marking}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource EngineNumber}" Width="100" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EngineNumber}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource Description}" Width="100" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Блок с ценой и кнопками -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PriceDisplay}" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DeliveryDate}" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding CheckPeriod}" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DeliveryArea}" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Installment}" FontSize="12" Margin="0,0,0,15" HorizontalAlignment="Right"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="{DynamicResource AddToCart}" Width="100" Height="30" 
                                                        Background="#FF3498DB" Foreground="White" Margin="0,0,10,0"/>
                                                <Button Content="{DynamicResource Buy}" Width="100" Height="30" 
                                                        Background="#FF2ECC71" Foreground="White"/>
                                            </StackPanel>

                                            <TextBlock Text="{DynamicResource AnyQuestions}" FontSize="12" 
                                                      Margin="0,15,0,0" HorizontalAlignment="Right"/>
                                            <Button Content="{DynamicResource OrderCall}" Width="150" Height="25" 
                                                    Background="Transparent" BorderBrush="#FF3498DB" 
                                                    BorderThickness="1" Foreground="#FF3498DB" 
                                                    Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>