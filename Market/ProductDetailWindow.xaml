<Window x:Class="Market.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Market"
        mc:Ignorable="d"
        Title="Детали товара" Height="430" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название детали -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Product.Title}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Product.ShortTitle}" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Картинка -->
                <StackPanel Grid.Column="0">
                    <Image Source="{Binding Product.ImagePath}" Height="250" Stretch="Uniform" Margin="0,10"/>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Year -->
                        <TextBlock Text="Год:" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Product.Year}" Grid.Row="0" Grid.Column="1"/>

                        <!-- Engine Type -->
                        <TextBlock Text="Тип двигателя:" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.EngineType}" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Marking -->
                        <TextBlock Text="Маркировка:" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.Marking}" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Engine Number -->
                        <TextBlock Text="Номер двигателя:" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.EngineNumber}" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Description -->
                        <TextBlock Text="Описание:" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.Description}" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0" TextWrapping="Wrap"/>

                        <!-- Price -->
                        <TextBlock Text="Цена:" Grid.Row="5" Grid.Column="0" FontWeight="Bold" Margin="0,10,5,0"/>
                        <TextBlock Text="{Binding Product.PriceDisplay}" Grid.Row="5" Grid.Column="1" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>

                        <!-- Delivery Date -->
                        <TextBlock Text="Доставка:" Grid.Row="6" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.DeliveryDate}" Grid.Row="6" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Check Period -->
                        <TextBlock Text="Проверка:" Grid.Row="7" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.CheckPeriod}" Grid.Row="7" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Delivery Area -->
                        <TextBlock Text="Регион доставки:" Grid.Row="8" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.DeliveryArea}" Grid.Row="8" Grid.Column="1" Margin="0,5,0,0"/>

                        <!-- Installment -->
                        <TextBlock Text="Рассрочка:" Grid.Row="9" Grid.Column="0" FontWeight="Bold" Margin="0,5,5,0"/>
                        <TextBlock Text="{Binding Product.Installment}" Grid.Row="9" Grid.Column="1" Margin="0,5,0,0"/>
                        
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="EditButton" Content="Редактировать" Width="120" Height="30" Margin="5" 
        Command="{Binding EditCommand}" Visibility="{Binding Source={x:Static local:App.CurrentUser}, Path=IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button x:Name="DeleteButton" Content="Удалить" Width="120" Height="30" Margin="5"
        Command="{Binding DeleteCommand}" Visibility="{Binding Source={x:Static local:App.CurrentUser}, Path=IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="{DynamicResource Language}" Width="120" Height="30" Margin="5" Click="LanguageButton_Click"/>
            
        </StackPanel>
    </Grid>
</Window>